# Copy this file to .env and fill in real values. .env is gitignored — never commit it,
# and never paste real values into chat, issues, or commit messages.

# --- Plaid ---
# From your Plaid dashboard (https://dashboard.plaid.com/team-settings/keys).
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | development | production
PLAID_ENV=production
# Comma-separated. "transactions" is all this app needs.
PLAID_PRODUCTS=transactions
# Comma-separated ISO country codes.
PLAID_COUNTRY_CODES=US
# Only required if you support OAuth institutions (e.g. Chase) — register this exact URL
# in the Plaid dashboard under Team Settings > API > Allowed redirect URIs.
PLAID_REDIRECT_URI=
# Public HTTPS URL this server is reachable at, used so Plaid can call POST /webhook.
# Leave blank while developing locally (no webhook is registered); set it once deployed.
PLAID_WEBHOOK_URL=

# --- App auth ---
# Shared secret the iOS app sends as `Authorization: Bearer <API_KEY>`. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# 32-byte key (as 64 hex chars) used to encrypt Plaid access tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this key makes stored access tokens unrecoverable — you'd need to re-link accounts.
TOKEN_ENCRYPTION_KEY=

# --- Server ---
PORT=4000
# Where the SQLite database file is written. Must be a persistent (non-ephemeral) volume
# in production, or every deploy/restart forgets your linked accounts. See Backend/README.md.
DATA_DIR=./data
